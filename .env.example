# Copy this to .env before running

# Which backend actually serves Gemma: "ollama" or "aistudio"
# Use aistudio if your laptop doesn't have the RAM to run Gemma locally.
GEMMA_BACKEND=ollama

# Ollama (local, offline, needs RAM — ~5GB min for gemma4:e2b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
# Use gemma4:e2b if your laptop has 8GB RAM instead of the full e4b model

# Google AI Studio (cloud, needs internet, works on any laptop)
# Get a free key at https://aistudio.google.com/apikey
AISTUDIO_API_KEY=
AISTUDIO_MODEL=gemma-4-26b-a4b-it
# confirmed working — larger option available: gemma-4-31b-it

# Text embeddings (uses the same AI Studio key above)
EMBEDDING_MODEL=gemini-embedding-001

# Vector store — plain JSON file, no database needed
VECTOR_STORE_PATH=./vector_store.json

# App
APP_ENV=development
